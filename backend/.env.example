# ==============================================================================
# Exemplo de Configuração Local Nexo - Backend (.env.example)
# Copie este arquivo para .env no diretório backend/
# ==============================================================================

# Banco de Dados (PostgreSQL 17 via Docker Compose)
POSTGRES_DB=ces-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=paodepovilho2003
DB_URL=jdbc:postgresql://localhost:5433/ces-db
DB_USER=postgres
DB_PASSWORD=paodepovilho2003

# Segredo JWT (HMAC-SHA256) e expiração em minutos (24h = 1440 min)
JWT_SECRET=7a5e92f1b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9a0b1c2d3e4f5a6b7c8d9e0
JWT_EXPIRATION=1440

# Senha do administrador padrão (USRADMIN) aplicada na subida do backend. Use em desenvolvimento e
# homologação para não perder o acesso; mínimo de 8 caracteres. Vazia = não altera nada (produção).
ADMIN_PADRAO_LOGIN=USRADMIN
ADMIN_PADRAO_SENHA=

# Chave mestra AES-256 (exatos 32 bytes) para cifragem de dados sensíveis
CRYPTO_KEY=troque-por-uma-chave-de-32-chars

# Auditoria de Solicitações (Chave Base64 com pelo menos 256 bits / 32 bytes)
CES_AUDITORIA_SOLICITACAO_VERSAO_ATIVA=v1
CES_AUDITORIA_SOLICITACAO_CHAVE_V1=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# Integração e CORS
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Feature Flags
CES_ESTOQUE_SOLICITACOES_TECNICAS_ENABLED=false
AI_ENABLED=false
# Modelo com visão, no mesmo provedor do chat, para ler os projetos das obras. Vazio = recurso indisponível.
AI_LLM_VISION_MODEL=
