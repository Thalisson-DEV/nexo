{
  "name": "ces-field-app-tmp",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false --browsers=ChromeHeadless",
    "e2e": "playwright test e2e/characterization e2e/piloto e2e/fase4 e2e/sw e2e/a11y e2e/visual",
    "e2e:baseline": "playwright test e2e/baseline",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:retomada": "playwright test e2e/piloto",
    "e2e:a11y": "playwright test e2e/a11y",
    "e2e:visual:atualizar": "playwright test e2e/visual --update-snapshots",
    "e2e:desempenho": "playwright test e2e/baseline/perf.spec.ts --project=android",
    "e2e:videos": "playwright test -c playwright.video.config.ts"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^20.3.20",
    "@angular/common": "^20.3.0",
    "@angular/compiler": "^20.3.0",
    "@angular/core": "^20.3.0",
    "@angular/forms": "^20.3.0",
    "@angular/platform-browser": "^20.3.0",
    "@angular/router": "^20.3.0",
    "@angular/service-worker": "^20.3.0",
    "barcode-detector": "3.2.2",
    "dexie": "^4.4.2",
    "jwt-decode": "^4.0.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^20.3.25",
    "@angular/cli": "^20.3.25",
    "@angular/compiler-cli": "^20.3.0",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@types/dexie": "^1.3.32",
    "@types/jasmine": "~5.1.0",
    "autoprefixer": "^10.5.0",
    "cypress": "^15.19.0",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.9.2"
  }
}
